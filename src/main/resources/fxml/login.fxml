<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<StackPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.example.controller.LoginController"
           stylesheets="@../css/login.css"
           style="-fx-background-image: url('images/cott.jpg'); -fx-background-size: cover; -fx-background-position: center; -fx-background-repeat: no-repeat;">

    <!-- VBox au centre de la page -->
    <VBox alignment="CENTER" spacing="15" styleClass="vbox">
        <Label text="Bienvenue dans votre application !" styleClass="welcome-message"/>
        <TextField fx:id="usernameField" promptText="Username" styleClass="text-field"/>
        <PasswordField fx:id="passwordField" promptText="Password" styleClass="password-field"/>
        <!-- Indicateur de chargement -->
        <ProgressIndicator fx:id="loadingIndicator" visible="false" />
        <Button text="Login" onAction="#handleLogin" styleClass="button"/>
        <Label fx:id="errorLabel" textFill="red" styleClass="errorLabel"/>
        <Button fx:id="signupButton" text="S'inscrire" onAction="#handleSignup" styleClass="button"/>
    </VBox>



</StackPane>
