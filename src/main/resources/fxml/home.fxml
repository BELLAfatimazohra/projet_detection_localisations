<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.web.WebView?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.TextArea?>
<AnchorPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.example.controller.HomeController">
    <children>
        <Label fx:id="welcomeLabel" layoutX="50" layoutY="50" text="Bienvenue" />

        <!-- Ajout de la barre de recherche -->
        <TextField fx:id="searchField" layoutX="50" layoutY="80" prefWidth="300" promptText="Entrez votre recherche ici..." />
        <Button layoutX="360" layoutY="80" text="Chercher" onAction="#handleSearch" />

        <!-- Barre latérale pour afficher les détails du lieu -->
        <VBox fx:id="sidebar" layoutX="400" layoutY="120" prefWidth="250" spacing="10">
            <Label text="Détails du Lieu" style="-fx-font-weight: bold;" />
            <Label fx:id="locationNameLabel" text="Nom : " />
            <Label fx:id="locationDescriptionLabel" text="Description : " />
        </VBox>

        <WebView fx:id="webView" layoutX="50" layoutY="120" />
        <Button layoutX="50" layoutY="350" text="Obtenir ma localisation" onAction="#handleGetLocation"/>
        <TextArea fx:id="locationTextArea" layoutX="50" layoutY="390" prefHeight="200" prefWidth="600" promptText="Les données de localisation s'afficheront ici..." />

    </children>
</AnchorPane>
