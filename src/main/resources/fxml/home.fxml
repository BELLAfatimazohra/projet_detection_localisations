<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.web.WebView?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.control.ProgressIndicator?>

<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.geometry.Insets?>
<AnchorPane  xmlns:fx="http://javafx.com/fxml" fx:controller="com.example.controller.HomeController"
            stylesheets="@../css/home.css">
    <children>
        <HBox spacing="20" prefHeight="800" prefWidth="1300">
            <!-- Sidebar à gauche -->
            <!-- ScrollPane enveloppant la VBox -->


            <VBox fx:id="locationVBox" spacing="15" prefWidth="300" style="-fx-background-color: #f0f0f0;" visible="false" managed="false">
                <Label fx:id="locationNameLabel" text="Nom de la localisation" styleClass="title-label"/>
                <Label fx:id="locationDescriptionLabel" text="Description" wrapText="true" styleClass="description-label"/>

                <!-- HBox pour les boutons sur la même ligne -->
                <HBox spacing="15">
                    <Button fx:id="itineraryButton" onAction="#handleitinerary" styleClass="circular-button">
                        <graphic>
                            <ImageView fx:id="itineraryIcon" fitWidth="20" fitHeight="20">
                                <Image url="@../images/itinerary-icon.png"/>
                            </ImageView>
                        </graphic>
                    </Button>
                    <Button fx:id="saveButton" onAction="#handleSave" styleClass="save-button">
                        <graphic>
                            <ImageView fx:id="saveIcon" fitWidth="20" fitHeight="20">
                                <Image url="@../images/save-icon.png"/>
                            </ImageView>
                        </graphic>
                    </Button>

                    <Button fx:id="meteobutton" onAction="#handlemeteo" styleClass="menu-button">
                        <graphic>
                            <ImageView fx:id="meteoicon" fitWidth="20" fitHeight="20">
                                <Image url="@../images/cloud.png"/>
                            </ImageView>
                        </graphic>
                    </Button>


                    
                </HBox>
                <!-- Ajout de la Label pour le message -->
                <Label fx:id="statusLabel" text="" styleClass="status-label" wrapText="true" visible="false" managed="false"/>

                <!-- Indicateur de chargement -->
                <ProgressIndicator fx:id="loadingIndicator" visible="false" />
                <Label fx:id="loadingLabel" text="Chargement..." visible="false" style="-fx-text-fill: blue;" />
            </VBox>
            <VBox fx:id="meteoVBox" prefWidth="300" style="-fx-margin-top: 50px;" visible="false" managed="false">
                <!-- Champ de texte pour saisir le lieu -->
                <TextField fx:id="locationField" promptText="Entrez un lieu pour la météo" style="-fx-margin-top: 50px;" styleClass="search-field"/>
                <HBox alignment="CENTER" >

                <!-- Bouton pour afficher la météo -->
                <Button fx:id="meteooButton" text="Afficher Météo" onAction="#handleMeteoVBOX" styleClass="menu-button">
                    <graphic>
                        <ImageView fx:id="meteooIcon" fitWidth="20" fitHeight="20">
                            <Image url="@../images/cloud.png"/>
                        </ImageView>
                    </graphic>
                </Button>
                </HBox>
            </VBox>

            <VBox fx:id="meteoafficherVBox" prefWidth="300" visible="false" managed="false">
                <!-- Contenu du VBox -->
            </VBox>




            <ScrollPane fx:id="restaurantScrollPane" prefWidth="300" fitToWidth="true" fitToHeight="true" visible="false" managed="false">
                <VBox fx:id="restaurantVBox" spacing="15" prefWidth="300" style="-fx-background-color: #f0f0f0;">
                    <Label text="Pas de Restaurants Pour Cette Zone" styleClass="title-label"/>
                    <!-- Ajoutez ici des éléments spécifiques aux restaurants -->
                </VBox>
            </ScrollPane>

            <ScrollPane fx:id="mosqueScrollPane" prefWidth="300" fitToWidth="true" fitToHeight="true" visible="false" managed="false">
                <VBox fx:id="mosqueVBox" spacing="15" prefWidth="300" style="-fx-background-color: #f0f0f0;">
                    <Label text="Pas de Mosquées Pour Cette Zone " styleClass="title-label"/>

                </VBox>
            </ScrollPane>


            <ScrollPane fx:id="pharmacyScrollPane" prefWidth="300" fitToWidth="true" fitToHeight="true" visible="false" managed="false">
                <VBox fx:id="pharmacyVBox" spacing="15" prefWidth="300" style="-fx-background-color: #f0f0f0;">
                    <Label text="Pas de Pharmacies Pour Cette Zone" styleClass="title-label"/>
                    <!-- Ajoutez ici des éléments spécifiques aux pharmacies -->
                </VBox>
            </ScrollPane>

            <ScrollPane fx:id="transportScrollPane" prefWidth="300" fitToWidth="true" fitToHeight="true" visible="false" managed="false">
                <VBox fx:id="transportVBox" spacing="15" prefWidth="300" style="-fx-background-color: #f0f0f0;">
                    <Label text=" Pas de Moyennne de Transports Pour Cette Zone" styleClass="title-label"/>
                    <!-- Ajoutez ici des éléments spécifiques aux pharmacies -->
                </VBox>
            </ScrollPane>

            <ScrollPane fx:id="recherchrecenteScrollPane" prefWidth="300" fitToWidth="true" fitToHeight="true" visible="false" managed="false">
                <VBox fx:id="recentSearchesVBox" spacing="15" prefWidth="300" style="-fx-background-color: #f0f0f0;">
                    <Label text="Recherches Recentes" styleClass="title-label"/>
                </VBox>
            </ScrollPane>

            <ScrollPane fx:id="enregistreScrollPane" prefWidth="300" fitToWidth="true" fitToHeight="true" visible="false" managed="false">

                <VBox fx:id="enregistreVBox" spacing="15" prefWidth="300" style="-fx-background-color: #f0f0f0;">

                    <Button fx:id="closeButton" text="Fermer" onAction="#handleClose" style="-fx-background-color: #FF0000;">
                        <graphic>
                            <ImageView fx:id="closIcon" fitWidth="20" fitHeight="20">
                                <Image url="@../images/close-icon.png"/>
                            </ImageView>
                        </graphic>
                    </Button>

                </VBox>

            </ScrollPane>

            <ScrollPane fx:id="profileScrollPane" prefWidth="300" fitToWidth="true" fitToHeight="true" visible="false" managed="false">
                <VBox fx:id="profileVBox" spacing="15" prefWidth="300" style="-fx-background-color: #f0f0f0;">
                    <Button fx:id="closeButtonpro" text="Fermer" onAction="#handleClose" style="-fx-background-color: #FF0000;">
                        <graphic>
                            <ImageView fx:id="closIconpro" fitWidth="20" fitHeight="20">
                                <Image url="@../images/close-icon.png"/>
                            </ImageView>
                        </graphic>
                    </Button>
                </VBox>
            </ScrollPane>

            <!-- Ajout des champs de départ et d'arrivée à l'intérieur de locationVBox -->

            <VBox fx:id="itineraryFieldsVBox" spacing="10"  styleClass="vbox-itinerary" prefWidth="300">

                <!-- HBox pour les boutons de sélection de mode de transport -->
                <HBox spacing="10" alignment="CENTER" styleClass="hbox-transport">
                    <VBox alignment="CENTER" spacing="5">
                        <Button fx:id="carModeButton" text="" onAction="#handleCarMode" styleClass="transport-button">
                            <graphic>
                                <ImageView fx:id="carIcon" fitWidth="20" fitHeight="20">
                                    <Image url="@../images/car-icon.png"/>
                                </ImageView>
                            </graphic>
                        </Button>
                        <Label fx:id="carDurationLabel" text=" " style="-fx-font-size: 14px;" />
                    </VBox>

                    <VBox alignment="CENTER" spacing="5">
                        <Button fx:id="bikeModeButton" text="" onAction="#handleBikeMode" styleClass="transport-button">
                            <graphic>
                                <ImageView fx:id="bikeIcon" fitWidth="20" fitHeight="20">
                                    <Image url="@../images/bike-icon.png"/>
                                </ImageView>
                            </graphic>
                        </Button>
                        <Label fx:id="bikeDurationLabel" text="---" style="-fx-font-size: 14px;" />
                    </VBox>
                    <VBox alignment="CENTER" spacing="5">
                        <Button fx:id="walkModeButton" text="" onAction="#handleWalkMode" styleClass="transport-button">
                            <graphic>
                                <ImageView fx:id="walkIcon" fitWidth="20" fitHeight="20">
                                    <Image url="@../images/walk-icon.png"/>
                                </ImageView>
                            </graphic>
                        </Button>
                        <Label fx:id="walkDurationLabel" text="---" style="-fx-font-size: 14px;" />
                    </VBox>

                </HBox>

                <!-- Champs pour les positions de départ et d'arrivée -->
                <TextField fx:id="startField" promptText="Position de départ"  styleClass="search-field"/>
                <TextField fx:id="endField" promptText="Position d'arrivée"  styleClass="search-field"/>
                <HBox alignment="CENTER" >
                    <Button fx:id="detectLocationButton" text="votre position" onAction="#handleDetectLocation" styleClass="location-button">
                        <graphic>
                            <ImageView fitWidth="20" fitHeight="20">
                                <Image url="@../images/location-icon.png" />
                            </ImageView>
                        </graphic>
                    </Button>

                </HBox>
                <Label fx:id="errorLabel" text="Une erreur s'est produite ." style="-fx-text-fill: red;" visible="false" managed="false"/>

                <!-- Bouton pour calculer l'itinéraire -->
            </VBox>

            <!-- Contenu principal -->
            <VBox spacing="20" layoutX="320" prefWidth="980" prefHeight="2000">
                <!-- Label d'accueil -->
                <HBox alignment="CENTER" spacing="10">
                    <Label fx:id="welcomeLabel" text="Bienvenue dans l'application" styleClass="welcome-label"/>
                    <ImageView fx:id="iconImageView" fitWidth="40" fitHeight="40" preserveRatio="true">
                        <Image url="@../images/img.png" />
                    </ImageView>
                </HBox>
                <!-- Ligne principale avec la barre de recherche et les boutons -->
                <HBox spacing="10" alignment="CENTER_LEFT" prefWidth="1000" >
                    <!-- Barre de recherche -->
                    <TextField fx:id="searchField" prefWidth="400" promptText="Rechercher une localisation..." styleClass="search-field"/>

                    <!-- Boutons d'actions -->
                    <HBox spacing="10" alignment="CENTER">
                        <!-- Bouton de recherche -->
                        <Button styleClass="circular-button" onAction="#handleSearch" maxWidth="50" maxHeight="50">
                            <graphic>
                                <ImageView fitWidth="30" fitHeight="30" preserveRatio="true">
                                    <image>
                                        <Image url="@../images/search.png"/>
                                    </image>
                                </ImageView>
                            </graphic>
                        </Button>

                        <!-- Bouton d'itinéraire -->
                        <Button styleClass="circular-button" onAction="#handleItinerary" maxWidth="50" maxHeight="50">
                            <graphic>
                                <ImageView fitWidth="30" fitHeight="30" preserveRatio="true">
                                    <image>
                                        <Image url="@../images/it.png"/>
                                    </image>
                                </ImageView>
                            </graphic>
                        </Button>
                    </HBox>

                    <!-- Boutons supplémentaires : Hotels, Mosquées, etc. -->
                    <HBox spacing="10" alignment="CENTER_RIGHT" prefWidth="600" >
                        <Button fx:id="restaurantsButton" text="Hotels" onAction="#handleRestaurants" styleClass="circular-button">
                            <graphic>
                                <ImageView fx:id="restaurantsIcon" fitWidth="20" fitHeight="20">
                                    <Image url="@../images/bed-solid.png"/>
                                </ImageView>
                            </graphic>
                        </Button>
                        <Button fx:id="mosquesButton" text="Mosquées" onAction="#handlemosque" styleClass="circular-button">
                            <graphic>
                                <ImageView fx:id="mosquesIcon" fitWidth="20" fitHeight="20">
                                    <Image url="@../images/mosques-icon.png"/>
                                </ImageView>
                            </graphic>
                        </Button>
                        <Button fx:id="pharmaciesButton" text="Pharmacies" onAction="#handlePharmacies" styleClass="circular-button">
                            <graphic>
                                <ImageView fx:id="pharmaciesIcon" fitWidth="20" fitHeight="20">
                                    <Image url="@../images/pharmacies-icon.png"/>
                                </ImageView>
                            </graphic>
                        </Button>
                        <Button fx:id="transportButton" text="Transports" onAction="#handleTransports" styleClass="circular-button">
                            <graphic>
                                <ImageView fx:id="transportIcon" fitWidth="20" fitHeight="20">
                                    <Image url="@../images/transport.png"/>
                                </ImageView>
                            </graphic>
                        </Button>
                    </HBox>
                </HBox>

                <!-- WebView pour afficher la carte -->
                <WebView fx:id="webView" prefHeight="550" prefWidth="900"  styleClass="map-view"/>
            </VBox>


            <VBox minWidth="50" maxWidth="100" spacing="10"  style="-fx-padding: 130 20 0 0;">
                <Button fx:id="meteoButton" onAction="#handleMeteo" styleClass="menu-button">
                    <graphic>
                        <ImageView fx:id="meteoIcon" fitWidth="20" fitHeight="20">
                            <Image url="@../images/cloud.png"/>
                        </ImageView>
                    </graphic>
                </Button>
                <!-- Vos boutons ici -->
                <Button fx:id="profil" onAction="#handleProfileDisplay" styleClass="menu-button">
                    <graphic>
                        <ImageView fx:id="profil_image" fitWidth="20" fitHeight="20">
                            <Image url="@../images/user.png"/>
                        </ImageView>
                    </graphic>
                </Button>
                <Button fx:id="adresse_enregistre" onAction="#handleadresseenredgistre" styleClass="menu-button">
                    <graphic>
                        <ImageView fx:id="settingsIcon" fitWidth="20" fitHeight="20">
                            <Image url="@../images/save-icon.png"/>
                        </ImageView>
                    </graphic>
                </Button>
                <Button fx:id="recherherecente" onAction="#handleRecentSearches" styleClass="menu-button">
                    <graphic>
                        <ImageView fx:id="recentIcon" fitWidth="20" fitHeight="20">
                            <Image url="@../images/recent.png"/>
                        </ImageView>
                    </graphic>
                </Button>
                <Button fx:id="logoutButton" onAction="#handleLogout" styleClass="menu-button">
                    <graphic>
                        <ImageView fx:id="logoutIcone" fitWidth="20" fitHeight="20">
                            <Image url="@../images/logout.png"/>
                        </ImageView>
                    </graphic>
                </Button>
                <Button fx:id="getLocationButton" onAction="#handleGetLocation" styleClass="menu-button">
                    <graphic>
                        <ImageView fx:id="locationIcon" fitWidth="20" fitHeight="20">
                            <Image url="@../images/location-icon.png"/>
                        </ImageView>
                    </graphic>
                </Button>
            </VBox>

        </HBox>
    </children>
</AnchorPane>