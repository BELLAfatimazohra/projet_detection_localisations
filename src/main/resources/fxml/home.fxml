<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.web.WebView?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.ListView?>

<AnchorPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.example.controller.HomeController"
            stylesheets="@../css/styles.css"> <!-- Chemin relatif vers le fichier CSS -->
    <children>
        <HBox spacing="10">
            <!-- Sidebar for Wikipedia details -->
            <VBox spacing="10" prefWidth="300" style="-fx-background-color: #f0f0f0;">
                <Label fx:id="locationNameLabel" text="Nom de la localisation" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                <Label fx:id="locationDescriptionLabel" text="Description" wrapText="true" style="-fx-font-size: 14px;"/>
                <Button fx:id="itineraryButton" text="Itinéraire" onAction="#handleItinerary" />
            </VBox>

            <!-- Main content -->
            <VBox spacing="10" layoutX="320">
                <Label fx:id="welcomeLabel" text="Bienvenue" />

                <!-- Search bar -->
                <TextField fx:id="searchField" prefWidth="300" promptText="Entrez votre recherche ici..." onKeyTyped="#onSearchFieldKeyTyped"/>
                <Button text="Chercher" onAction="#handleSearch" />

                <!-- WebView for displaying map -->
                <WebView fx:id="webView" prefHeight="400" />
                <Button layoutX="50" layoutY="350" text="Obtenir ma localisation" onAction="#handleGetLocation"/>


            </VBox>
        </HBox>
    </children>
</AnchorPane>
