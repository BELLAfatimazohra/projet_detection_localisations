<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.web.WebView?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.control.ProgressIndicator?>

<?import javafx.scene.control.ScrollPane?>
<AnchorPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.example.controller.HomeController"
            stylesheets="@../css/home.css">
    <children>
        <HBox spacing="20" prefHeight="600" prefWidth="1000">
            <!-- Sidebar à gauche -->
            <!-- ScrollPane enveloppant la VBox -->

                <VBox fx:id="locationVBox" spacing="15" prefWidth="400" style="-fx-background-color: #f0f0f0;" visible="false" managed="false">
                    <Label fx:id="locationNameLabel" text="Nom de la localisation" styleClass="title-label"/>
                    <Label fx:id="locationDescriptionLabel" text="Description" wrapText="true" styleClass="description-label"/>

                    <!-- HBox pour les boutons sur la même ligne -->
                    <HBox spacing="15">
                        <Button fx:id="itineraryButton" onAction="#handleItinerary" styleClass="description-label">
                            <graphic>
                                <ImageView fx:id="itineraryIcon" fitWidth="20" fitHeight="20">
                                    <Image url="@../images/itinerary-icon.png"/>
                                </ImageView>
                            </graphic>
                        </Button>
                        <Button fx:id="saveButton" onAction="#handleSave" styleClass="save-button">
                            <graphic>
                                <ImageView fx:id="saveIcon" fitWidth="20" fitHeight="20">
                                    <Image url="@../images/save-icon.png"/>
                                </ImageView>
                            </graphic>
                        </Button>
                    </HBox>
                </VBox>

            <ScrollPane fx:id="restaurantScrollPane" prefWidth="400" fitToWidth="true" fitToHeight="true" visible="false" managed="false">
                <VBox fx:id="restaurantVBox" spacing="15" prefWidth="400" style="-fx-background-color: #f0f0f0;">
                    <Label text="Restaurants" styleClass="title-label"/>
                    <!-- Ajoutez ici des éléments spécifiques aux restaurants -->
                </VBox>
            </ScrollPane>

            <ScrollPane fx:id="mosqueScrollPane" prefWidth="400" fitToWidth="true" fitToHeight="true" visible="false" managed="false">
                <VBox fx:id="mosqueVBox" spacing="15" prefWidth="400" style="-fx-background-color: #f0f0f0;">
                    <Label text="Mosquées" styleClass="title-label"/>

                </VBox>
            </ScrollPane>


            <ScrollPane fx:id="pharmacyScrollPane" prefWidth="400" fitToWidth="true" fitToHeight="true" visible="false" managed="false">
                <VBox fx:id="pharmacyVBox" spacing="15" prefWidth="400" style="-fx-background-color: #f0f0f0;">
                    <Label text="Pharmacies" styleClass="title-label"/>
                    <!-- Ajoutez ici des éléments spécifiques aux pharmacies -->
                </VBox>
            </ScrollPane>

            <ScrollPane fx:id="transportScrollPane" prefWidth="400" fitToWidth="true" fitToHeight="true" visible="false" managed="false">
                <VBox fx:id="transportVBox" spacing="15" prefWidth="400" style="-fx-background-color: #f0f0f0;">
                    <Label text="Transports" styleClass="title-label"/>
                    <!-- Ajoutez ici des éléments spécifiques aux pharmacies -->
                </VBox>
            </ScrollPane>

            <ScrollPane fx:id="recherchrecenteScrollPane" prefWidth="400" fitToWidth="true" fitToHeight="true" visible="false" managed="false">
                <VBox fx:id="recentSearchesVBox" spacing="15" prefWidth="400" style="-fx-background-color: #f0f0f0;">
                    <Label text="Recherches Recentes" styleClass="title-label"/>
                </VBox>
            </ScrollPane>

            <ScrollPane fx:id="enregistreScrollPane" prefWidth="400" fitToWidth="true" fitToHeight="true" visible="false" managed="false">
                <VBox fx:id="enregistreVBox" spacing="15" prefWidth="400" style="-fx-background-color: #f0f0f0;">
                    <Label text="Recherches Recentes" styleClass="title-label"/>
                </VBox>
            </ScrollPane>

            <ScrollPane fx:id="profileScrollPane" prefWidth="400" fitToWidth="true" fitToHeight="true" visible="false" managed="false">
                <VBox fx:id="profileVBox" spacing="15" prefWidth="400" style="-fx-background-color: #f0f0f0;">

                </VBox>
            </ScrollPane>

            <!-- Ajout des champs de départ et d'arrivée à l'intérieur de locationVBox -->
            <VBox fx:id="itineraryFieldsVBox" spacing="10" visible="false" managed="false" styleClass="vbox-itinerary">

                <!-- HBox pour les boutons de sélection de mode de transport -->
                <HBox spacing="10" alignment="CENTER" styleClass="hbox-transport">
                    <VBox alignment="CENTER" spacing="5">
                    <Button fx:id="carModeButton"  onAction="#handleCarMode" styleClass="transport-button">
                        <graphic>
                            <ImageView fx:id="carIcon" fitWidth="20" fitHeight="20">
                                <Image url="@../images/car-icon.png"/>
                            </ImageView>
                        </graphic>
                    </Button>
                    <Label fx:id="carDurationLabel" text=" " />
                    </VBox>
                    <VBox alignment="CENTER" spacing="5">
                    <Button fx:id="bikeModeButton" onAction="#handleBikeMode" styleClass="transport-button">
                        <graphic>
                            <ImageView fx:id="bikeIcon" fitWidth="20" fitHeight="20">
                                <Image url="@../images/bike-icon.png"/>
                            </ImageView>
                        </graphic>
                    </Button>
                    <Label fx:id="bikeDurationLabel" text=" " />
                    </VBox>
                    <VBox alignment="CENTER" spacing="5">
                    <Button fx:id="walkModeButton" text="" onAction="#handleWalkMode" styleClass="transport-button">
                        <graphic>
                            <ImageView fx:id="walkIcon" fitWidth="20" fitHeight="20">
                                <Image url="@../images/walk-icon.png"/>
                            </ImageView>
                        </graphic>
                    </Button>
                    <Label fx:id="walkDurationLabel" text=" " />
                    </VBox>
                    <VBox alignment="CENTER" spacing="5">
                    <Button fx:id="closeItineraryButton" text=""  onAction="#handleCloseItinerary" styleClass="transport-button">
                        <graphic>
                            <ImageView fx:id="closeIcon" fitWidth="20" fitHeight="20">
                                <Image url="@../images/close-icon.png"/>
                            </ImageView>
                        </graphic>
                    </Button>
                        <Label text="" style="-fx-font-size: 14px;" />
                    </VBox>
                </HBox>

                <!-- Champs pour les positions de départ et d'arrivée -->
                <TextField fx:id="startField" promptText="Position de départ"  styleClass="search-field"/>
                <TextField fx:id="endField" promptText="Position d'arrivée"  styleClass="search-field"/>

                <!-- Bouton pour calculer l'itinéraire -->
                <!--<Button text="Calculer itinéraire" onAction="#handleCalculateItinerary" styleClass="search-button"/>-->
            </VBox>





            <!-- Contenu principal -->
            <VBox spacing="20" layoutX="320" prefWidth="800">
                <Label fx:id="welcomeLabel" text="Bienvenue dans l'application" styleClass="welcome-label"/>

                <!-- Barre de recherche -->
                <HBox spacing="10">
                    <TextField fx:id="searchField" prefWidth="400" promptText="Rechercher une localisation..." onKeyTyped="#onSearchFieldKeyTyped" styleClass="search-field"/>
                    <Button fx:id="searchButton" text="Chercher" onAction="#handleSearch" styleClass="search-button"/>
                    <!-- Nouveau bouton Itinéraire -->
                    <Button fx:id="itineraryButtonhome" text="Itinéraire" onAction="#handleItinerary" styleClass="search-button"/>
                </HBox>

                <!-- WebView pour afficher la carte -->
                <WebView fx:id="webView" prefHeight="600" styleClass="map-view"/>

                <!-- Section inférieure -->
                <HBox spacing="20" alignment="CENTER_RIGHT">
                    <Button fx:id="restaurantsButton" text="Hotels" onAction="#handleRestaurants" styleClass="secondary-button">
                        <graphic>
                            <ImageView fx:id="restaurantsIcon" fitWidth="20" fitHeight="20">
                                <Image url="@../images/bed-solid.png"/>
                            </ImageView>
                        </graphic>
                    </Button>
                    <Button fx:id="mosquesButton" text="Mosquées" onAction="#handlemosque" styleClass="secondary-button">
                        <graphic>
                            <ImageView fx:id="mosquesIcon" fitWidth="20" fitHeight="20">
                                <Image url="@../images/mosques-icon.png"/>
                            </ImageView>
                        </graphic>
                    </Button>
                    <Button fx:id="pharmaciesButton" text="Pharmacies" onAction="#handlePharmacies" styleClass="secondary-button">
                        <graphic>
                            <ImageView fx:id="pharmaciesIcon" fitWidth="20" fitHeight="20">
                                <Image url="@../images/pharmacies-icon.png"/>
                            </ImageView>
                        </graphic>
                    </Button>
                    <Button fx:id="transportButton" text="Transports" onAction="#handleTransports" styleClass="secondary-button">
                        <graphic>
                            <ImageView fx:id="transportIcon" fitWidth="20" fitHeight="20">
                                <Image url="@../images/transport.png"/>
                            </ImageView>
                        </graphic>
                    </Button>


                </HBox>

                <!-- Indicateur de chargement -->
                <ProgressIndicator fx:id="loadingIndicator" visible="false" />
                <Label fx:id="loadingLabel" text="Chargement..." visible="false" style="-fx-text-fill: blue;" />
            </VBox>

            <!-- Profil et menu -->
            <VBox minWidth="50" maxWidth="100" spacing="10" alignment="top_center" >
                <Button fx:id="profil" onAction="#handleProfileDisplay" styleClass="profil">
                    <graphic>
                        <ImageView fx:id="profil_image" fitWidth="20" fitHeight="20">
                            <Image url="@../images/user.png"/>
                        </ImageView>
                    </graphic>
                </Button>
                <Button fx:id="adresse_enregistre" onAction="#handleadresseenredgistre" styleClass="menu-button">
                    <graphic>
                        <ImageView fx:id="settingsIcon" fitWidth="20" fitHeight="20">
                            <Image url="@../images/save-icon.png"/>
                        </ImageView>
                    </graphic>
                </Button>
                <Button fx:id="recherherecente" onAction="#handleRecentSearches" styleClass="menu-button">
                    <graphic>
                        <ImageView fx:id="recentIcon" fitWidth="20" fitHeight="20">
                            <Image url="@../images/recent.png"/>
                        </ImageView>
                    </graphic>
                </Button>
                <Button fx:id="logoutButton" onAction="#handleLogout" styleClass="menu-button">
                    <graphic>
                        <ImageView fx:id="logoutIcone" fitWidth="20" fitHeight="20">
                            <Image url="@../images/logout.png"/>
                        </ImageView>
                    </graphic>
                </Button>
                <Button fx:id="getLocationButton" onAction="#handleGetLocation" styleClass="menu-button">
                    <graphic>
                        <ImageView fx:id="locationIcon" fitWidth="20" fitHeight="20">
                            <Image url="@../images/location-icon.png"/>
                        </ImageView>
                    </graphic>
                </Button>
            </VBox>

        </HBox>
    </children>
</AnchorPane>
